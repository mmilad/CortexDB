# CortexDB API server
CORTEXDB_API_HOST=127.0.0.1
CORTEXDB_API_PORT=5000
CORTEXDB_API_RELOAD=true

# Storage
CORTEXDB_DB_PATH=cortexdb.sqlite
CORTEXDB_NAMESPACE_DIR=.cortexdb/namespaces

# Embedding
CORTEXDB_EMBED_PROVIDER=ollama
CORTEXDB_EMBED_MODEL=nomic-embed-text

# Optional LLM provider for derived ingest work (summaries, facts, decisions, goals).
# Defaults here target a local Ollama-compatible endpoint.
CORTEXDB_LLM_PROVIDER=api
CORTEXDB_LLM_URL=http://127.0.0.1:11434
CORTEXDB_LLM_MODEL=llama3
# CORTEXDB_LLM_API_KEY=
