# CortexDB API server
CORTEXDB_API_HOST=127.0.0.1
CORTEXDB_API_PORT=5000
CORTEXDB_API_RELOAD=true

# Storage
CORTEXDB_DB_PATH=cortexdb.sqlite
CORTEXDB_NAMESPACE_DIR=.cortexdb/namespaces

# Embedding
CORTEXDB_EMBED_PROVIDER=ollama
CORTEXDB_EMBED_MODEL=nomic-embed-text

# Processor client used by the CortexDB API.
# Set PROVIDER=sidecar when app.processors.serve is running separately.
CORTEXDB_PROCESSOR_CLIENT_PROVIDER=sidecar
CORTEXDB_PROCESSOR_CLIENT_URL=http://127.0.0.1:5010
CORTEXDB_PROCESSOR_CLIENT_STRATEGY=safe
CORTEXDB_PROCESSOR_CLIENT_CLASSIFY=true
CORTEXDB_PROCESSOR_CLIENT_KNOWN_THRESHOLD=0.72
CORTEXDB_PROCESSOR_CLIENT_CANDIDATE_THRESHOLD=0.45
CORTEXDB_PROCESSOR_CLIENT_FALLBACK=true

# Processor sidecar runtime only. These values are read by cortexdb-processor,
# not by the CortexDB API client.
CORTEXDB_PROCESSOR_SIDECAR_HOST=127.0.0.1
CORTEXDB_PROCESSOR_SIDECAR_PORT=5010
CORTEXDB_PROCESSOR_SIDECAR_RELOAD=true
# Future sidecar model/runtime settings:
# CORTEXDB_PROCESSOR_SIDECAR_SPACY_MODEL=en_core_web_sm
# CORTEXDB_PROCESSOR_SIDECAR_MINILM_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CORTEXDB_PROCESSOR_SIDECAR_DEVICE=cpu

# Optional LLM provider for derived ingest work (summaries, facts, decisions, goals).
# Defaults here target a local Ollama-compatible endpoint.
CORTEXDB_LLM_PROVIDER=api
CORTEXDB_LLM_URL=http://127.0.0.1:11434
CORTEXDB_LLM_MODEL=llama3
# CORTEXDB_LLM_API_KEY=
